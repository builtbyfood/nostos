# Nostos 0.2.3 - .gitattributes
# Text files are stored with LF in the repository whatever the committer's OS.
* text=auto

*.sh                       text eol=lf
packaging/nostos-launcher  text eol=lf
*.py                       text eol=lf
*.go                       text eol=lf
*.cmd                      text eol=crlf
*.ps1                      text eol=crlf
*.exe                      binary
*.png                      binary
